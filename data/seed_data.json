  "definitions": [
    {
      "domain": "Eficacia",
      "criteria": "Cambio medio en la agudeza visual corregida (BCVA)",
      "operationalDefinition": "Magnitud del cambio promedio en letras de BCVA después del tratamiento, comparado con el valor basal . Refleja la ganancia funcional visual promedio atribuible a la intervención.",
      "possibleValues": "0–5 letras = 1; 6–10 letras = 2; 11–15 letras = 4; >15 letras = 5"
    },
    {
      "domain": "Eficacia",
      "criteria": "Pacientes con ganancia ≥15 letras en BCVA",
      "operationalDefinition": "Proporción de pacientes que alcanzan una mejoría clínicamente relevante de al menos 15 letras en BCVA durante el seguimiento del estudio. Este desenlace representa una recuperación visual significativa.",
      "possibleValues": "0–15% = 1; 16–30% = 3; >30% = 5"
    },
    {
      "domain": "Seguridad",
      "criteria": "Desprendimiento de retina",
      "operationalDefinition": "Frecuencia de pacientes que presentan desprendimiento de retina  reportado como evento adverso serio durante el seguimiento del tratamiento.",
      "possibleValues": "5 = 0%\n4 = >0% a <0,5%\n3 = ≥0,5% a <1%\n2 = ≥1% a <3%\n1 = ≥3%"
    },
    {
      "domain": "Seguridad",
      "criteria": "Evento cerebrovascular",
      "operationalDefinition": "Frecuencia de pacientes que presentan un evento cerebrovascular reportado como evento adverso serio durante el periodo de seguimiento del tratamiento",
      "possibleValues": "5 = 0%\n4 = >0% a <0,5%\n3 = ≥0,5% a <1%\n2 = ≥1% a <3%\n1 = ≥3%"
    },
    {
      "domain": "Seguridad",
      "criteria": "Infarto agudo de miocardio",
      "operationalDefinition": "Frecuencia de pacientes que presentan infarto agudo de miocardio reportado como evento adverso serio durante el seguimiento del tratamiento.",
      "possibleValues": "5 = 0%\n4 = >0% a <0,5%\n3 = ≥0,5% a <1%\n2 = ≥1% a <3%\n1 = ≥3%"
    },
    {
      "domain": "Seguridad",
      "criteria": "Vitreitis",
      "operationalDefinition": "Frecuencia de pacientes que presentan Vitreitis reportada como evento adverso  durante el seguimiento del tratamiento",
      "possibleValues": "5 = 0%\n4 = >0% a <0,5%\n3 = ≥0,5% a <1%\n2 = ≥1% a <3%\n1 = ≥3%"
    },
    {
      "domain": "Seguridad",
      "criteria": "Supresión sistémica de VEGF",
      "operationalDefinition": "Duración o persistencia de la reducción de VEGF sistémico posterior a la administración del medicamento. Evalúa el potencial efecto sistémico del tratamiento sobre la vía VEGF.",
      "possibleValues": "Prolongada = 1; No prolongada = 5"
    },
    {
      "domain": "PROs",
      "criteria": "Calidad de vida relacionada con la salud",
      "operationalDefinition": "Cambio reportado en instrumentos de calidad de vida relacionada con la salud, incluyendo dominios visuales, funcionales o generales. Se clasifica según si el tratamiento empeora, no modifica o mejora la calidad de vida.",
      "possibleValues": "Empeoramiento = 1; Sin efecto = 3; Mejoría = 5"
    },
    {
      "domain": "PROs",
      "criteria": "Discapacidad / capacidad funcional",
      "operationalDefinition": "Cambio en la capacidad del paciente para realizar actividades cotidianas o mantener independencia funcional, medido mediante escalas funcionales, dominios visuales o reportes de desempeño.",
      "possibleValues": "Empeoramiento = 1; Sin efecto = 3; Mejoría = 5"
    },
    {
      "domain": "Organizativo",
      "criteria": "Estado de aprobación regulatoria",
      "operationalDefinition": "Condición regulatoria de uso del medicamento para la indicación evaluada. Diferencia si el tratamiento está aprobado específicamente para esa indicación o si su uso corresponde a una indicación no aprobada.",
      "possibleValues": "Off-label = 1; On-label = 5"
    },
    {
      "domain": "Organizativo",
      "criteria": "Inclusión en guías de práctica clínica",
      "operationalDefinition": "Presencia del medicamento o estrategia terapéutica en guías de práctica clínica relevantes para la indicación evaluada. Refleja el respaldo de recomendaciones clínicas formales.",
      "possibleValues": "No incluido = 1; Incluido = 5"
    }
  ],
